{
  "name": "yurewatch",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Japan Earthquake Early Warning (EEW) viewer — map-centric real-time monitoring UI for Android and the web.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inline-single-file.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "map:data": "python3 scripts/build_map_data.py",
    "android:apk": "bash tools/build-apk.sh",
    "verify:web": "node tools/verify-web.mjs",
    "test:all": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=18"
  }
}
