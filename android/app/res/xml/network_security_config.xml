<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. No cleartext fallback, no user-installed CAs trusted for app
     traffic: the viewer must not silently accept a tampered earthquake feed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
